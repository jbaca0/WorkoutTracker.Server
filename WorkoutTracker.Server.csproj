<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="WorkoutTracker.Server.Tests/**" />
    <Content Remove="WorkoutTracker.Server.Tests/**" />
    <EmbeddedResource Remove="WorkoutTracker.Server.Tests/**" />
